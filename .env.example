DATABASE_URL=sqlite://data.db
HOST=0.0.0.0
PORT=3000
#DEFAULT_API_KEY=sk-xxx
#LOG_FILE=app.log

# 会话 Cookie 的 HMAC 签名密钥。生成方式：openssl rand -hex 32
# 不设置时会随机生成临时的，服务重启后所有登录都会失效（仅适合本地调试）
#SESSION_SECRET=

# https 部署时设为 true，让 session Cookie 带上 Secure 属性
# 用 http:// 访问时不要开，否则浏览器会直接丢弃 Cookie
#COOKIE_SECURE=true

# DeepSeek 接口地址，默认走官方端点
# 需要走代理或兼容网关时改成对应的 .../chat/completions
#DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions

# 同时并发发出的翻译请求数（默认 3，范围 1-8）
# 调大能加快长文件，但注意 API 的速率限制
#TRANSLATE_CONCURRENCY=3
